# Copy this file to `.env` and fill in your project values.
#   cp .env.example .env
#
# NEVER commit the real `.env` — it is gitignored.
# In Expo, only `EXPO_PUBLIC_` prefixed variables are inlined into the client
# bundle. Values in `process.env.EXPO_PUBLIC_*` are visible to end users, so
# they must never contain secrets (e.g. the Supabase service_role key).

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# The unique API endpoint for your Supabase project.
# Found at: Dashboard > Project Settings > API
# Example: https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The Supabase anon key. This key is PUBLIC by design — it is safe to embed in
# the app because your Postgres Row Level Security (RLS) policies protect the
# data. Never use the service_role key here; it bypasses RLS and is a secret.
# Found at: Dashboard > Project Settings > API > Project API keys > anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=